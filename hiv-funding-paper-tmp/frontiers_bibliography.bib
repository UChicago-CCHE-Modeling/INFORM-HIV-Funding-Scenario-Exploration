	pmcid = {PMC10268224},
	keywords = {Cooperative Behavior, COVID-19, evolutionary game theory, Game Theory, Humans, Pandemics, prisoner’s dilemma, SARS-CoV-2, social conflict},
	pages = {e2303546120},
	file = {Full Text:/Users/annahotton/Zotero/storage/N5BQXA65/Traulsen et al. - 2023 - Individual costs and societal benefits of interven.pdf:application/pdf},
}




